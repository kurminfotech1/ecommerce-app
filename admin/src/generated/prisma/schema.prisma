generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          String            @id @default(uuid())
  email       String            @unique
  full_name   String?
  password    String?
  role        Role              @default(ADMIN)
  phone       String?
  country     String?
  state       String?
  city        String?
  postal_code String?
  createdAt   DateTime          @default(now())
  permissions AdminPermission[]
}

model Category {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  parentId   String?
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Category[] @relation("CategoryTree")
  products   Product[]
}

model Product {
  id                String           @id @default(uuid())
  category_id       String
  product_name      String
  slug              String           @unique
  short_desc        String?
  description       String?
  ingredient        String?
  benefits          String[]
  certifications    String[]
  country_of_origin String?
  expiry_months     Int?
  storage_info      String?
  allergen_info     String?
  sold_count        Int              @default(0)
  rating_avg        Float            @default(0)
  rating_count      Int              @default(0)
  is_active         Boolean          @default(true)
  is_featured       Boolean          @default(false)
  is_bestseller     Boolean          @default(false)
  is_new            Boolean          @default(false)
  is_upcoming       Boolean          @default(false)
  meta_title        String?
  meta_desc         String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  how_to_use        Json             @default("[]")
  key_benefits      Json             @default("[]")
  why_choose_us     Json             @default("[]")
  category          Category         @relation(fields: [category_id], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  wishlist          Wishlist[]

  @@index([slug])
  @@index([is_active])
  @@index([is_featured])
  @@index([is_bestseller])
  @@index([is_new])
  @@index([is_upcoming])
}

model ProductVariant {
  id                  String         @id @default(uuid())
  product_id          String
  size                String?
  color               String?
  weight              String?
  price               Float
  compare_price       Float?
  stock               Int            @default(0)
  low_stock_threshold Int            @default(5)
  sku                 String         @unique
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  cartItems           Cart[]
  orderItems          OrderItem[]
  product             Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  stockLogs           StockLog[]
  images              VariantImage[]

  @@index([price])
  @@index([stock])
}

model StockLog {
  id         String         @id @default(uuid())
  variant_id String
  change     Int
  reason     String
  created_at DateTime       @default(now())
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
}

model ProductImage {
  id         String  @id @default(uuid())
  product_id String
  image_url  String
  alt_text   String?
  sort_order Int     @default(0)
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model VariantImage {
  id         String         @id @default(uuid())
  variant_id String
  image_url  String
  alt_text   String?
  sort_order Int            @default(0)
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([variant_id])
}

model User {
  id          String          @id @default(uuid())
  full_name   String
  email       String          @unique
  password    String
  phone       String
  is_verified Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  addresses   Address[]
  cart        Cart[]
  orders      Order[]
  returns     ReturnRequest[]
  reviews     Review[]
  wishlist    Wishlist[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Cart {
  id         String         @id @default(uuid())
  user_id    String
  variant_id String
  quantity   Int
  price      Float
  created_at DateTime       @default(now())
  user       User           @relation(fields: [user_id], references: [id])
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([user_id, variant_id])
}

model Order {
  id               String          @id @default(uuid())
  order_number     String          @unique
  user_id          String
  total_amount     Float
  order_status     OrderStatus     @default(PLACED)
  shipping_name    String
  shipping_phone   String
  shipping_address String
  shipping_city    String
  shipping_state   String
  shipping_pincode String
  shipping_country String
  created_at       DateTime        @default(now())
  user             User            @relation(fields: [user_id], references: [id])
  items            OrderItem[]
  payment          Payment?
  returnRequests   ReturnRequest[]

  @@index([order_status])
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  variant_id String?
  quantity   Int
  price      Float

  // Product snapshot for history
  product_name String?
  sku          String?
  weight       String?
  size         String?
  image_url    String?

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)
}

model Payment {
  id             String        @id @default(uuid())
  order_id       String        @unique
  payment_method String
  transaction_id String
  amount         Float
  status         PaymentStatus @default(PENDING)
  created_at     DateTime      @default(now())
  order          Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id         String       @id @default(uuid())
  order_id   String
  user_id    String
  reason     String
  status     ReturnStatus @default(REQUESTED)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  order      Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  user_id    String
  product_id String
  rating     Int
  title      String?
  body       String?
  status     String   @default("Pending")
  created_at DateTime @default(now())
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Wishlist {
  id         String  @id @default(uuid())
  user_id    String
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model BlogTag {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  created_at DateTime @default(now())
  blogs      Blog[]   @relation("BlogToBlogTag")
}

model Blog {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  featured_image String?
  category       String
  author         String
  meta_title     String?
  meta_desc      String?
  canonical_url  String?
  is_draft       Boolean   @default(false)
  is_published   Boolean   @default(false)
  is_featured    Boolean   @default(false)
  published_at   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  tags           BlogTag[] @relation("BlogToBlogTag")

  @@index([slug])
  @@index([is_published])
  @@index([is_draft])
  @@index([is_featured])
  @@index([published_at])
  @@index([category])
}

model AdminPermission {
  id        String   @id @default(uuid())
  adminId   String
  module    String
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(true)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, module])
}

model OtpVerification {
  id         String   @id @default(uuid())
  email      String   @unique
  otp        String
  expires_at DateTime
  created_at DateTime @default(now())
}

model SiteLogo {
  id          String   @id @default("site-logo")
  light_url   String?
  dark_url    String?
  favicon_url String?
  updated_at  DateTime @updatedAt
}

model AnnouncementBar {
  id         String   @id @default(uuid())
  text       String
  priority   Int      @default(1)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model AnnouncementSettings {
  id         String   @id @default("announcement-settings")
  is_enabled Boolean  @default(true)
  updated_at DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}
